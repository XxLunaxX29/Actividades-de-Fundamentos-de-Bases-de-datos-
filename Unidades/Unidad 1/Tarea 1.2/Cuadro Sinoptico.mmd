    class C1_1_CAR,C1_2_CAR,C1_3_CAR,C2_1_CAR,C2_2_CAR,C3_1_CAR,C3_2_CAR,C3_3_CAR,C4_1_CAR,C4_2_CAR,C4_3_CAR,C4_4_CAR,C4_5_CAR,C4_6_CAR,C4_7_CAR,C4_8_CAR charStyle;
