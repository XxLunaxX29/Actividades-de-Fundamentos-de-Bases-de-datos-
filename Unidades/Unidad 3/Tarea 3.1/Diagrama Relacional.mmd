erDiagram
    TIPO_USUARIO {
        int ID_TipoUsuario PK
        string Descripcion
    }

    USUARIO {
        int ID_Usuario PK
        string Nombre_Pila
        string Apellido_Paterno
        string Apellido_Materno
        int ID_TipoUsuario FK
    }

    TELEFONO {
        int ID_Telefono PK
        string Numero
        string Descripcion
        int ID_Usuario FK
    }

    CLIENTE {
        int ID_Usuario PK "FK"
        string Estado
    }

    EMPLEADO {
        int ID_Usuario PK "FK"
        string Puesto
        float Salario
    }

    MEMBRESIA {
        int ID_Membresia PK
        string Tipo
        float Costo
        int Duracion_Dias
    }

    PAGO_MEMBRESIA {
        int ID_Pago PK
        date Fecha_Pago
        int ID_Cliente FK
        int ID_Empleado FK
        int ID_Membresia FK
    }

    LOCKER {
        int ID_Locker PK
        string Numero_Locker
        int ID_Pago FK
    }

    RUTINA {
        int ID_Rutina PK
        string Dificultad
        string Objetivo
        string Descripcion
        int ID_Empleado FK
    }

    ASIGNACION_RUTINA {
        int ID_Cliente PK "FK"
        int ID_Rutina PK "FK"
        date Fecha_Asignacion
    }

    TIPO_USUARIO ||--o{ USUARIO : clasifica
    USUARIO ||--o{ TELEFONO : tiene
    USUARIO ||--o| CLIENTE : es_un
    USUARIO ||--o| EMPLEADO : es_un
    CLIENTE ||--o{ PAGO_MEMBRESIA : realiza
    EMPLEADO ||--o{ PAGO_MEMBRESIA : cobra
    MEMBRESIA ||--o{ PAGO_MEMBRESIA : contratada_en
    PAGO_MEMBRESIA |o--o| LOCKER : asigna
    EMPLEADO ||--o{ RUTINA : diseña
    CLIENTE ||--o{ ASIGNACION_RUTINA : recibe
    RUTINA ||--o{ ASIGNACION_RUTINA : asignada_en
